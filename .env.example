# Copia este archivo como ".env" y completa TUS valores. El ".env" real nunca se sube a GitHub.
# En Render estas mismas variables se definen en: Environment > Environment Variables.

# Cadena de conexión de Neon (Dashboard > Connect). Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/NOMBRE_BD?sslmode=require

# Secreto para firmar los tokens JWT (mínimo 16 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRA=8h

# Puerto local. Render define PORT automáticamente.
PORT=3000

# URLs del frontend autorizadas a llamar a la API, separadas por coma.
# Vacío = cualquiera (solo para desarrollo). En producción pon la URL de Vercel.
CORS_ORIGINS=http://localhost:5173

# true = acepta contraseñas antiguas en texto plano y las convierte a bcrypt al primer login.
# Ponlo en false después de ejecutar "npm run db:migrar-claves -- --aplicar".
ACEPTAR_CLAVES_LEGADO=true
